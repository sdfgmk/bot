# توکن ربات از @BotFather
BOT_TOKEN=

# آیدی عددی تلگرام خودت (برای اینکه اولین ادمین باشی). با @userinfobot بگیرش
INITIAL_ADMIN_IDS=123456789

# آدرس پنل X4G روی Railway (بدون اسلش آخر)
X4G_BASE_URL=https://your-x4g-app.up.railway.app

# همون BOT_API_KEY که روی سرویس X4G ست کردی (باید دقیقاً یکی باشه)
X4G_BOT_API_KEY=یک-رشته-تصادفی-طولانی-بساز

# اطلاعات کارت برای پرداخت دستی
CARD_NUMBER=0000-0000-0000-0000
CARD_OWNER=نام و نام‌خانوادگی

# روی Railway نیازی به تنظیم دستی نیست (خودکار ست میشه)، لوکال می‌تونی خالی بذاری
# RAILWAY_PUBLIC_DOMAIN=

DB_PATH=/data/bot.db
